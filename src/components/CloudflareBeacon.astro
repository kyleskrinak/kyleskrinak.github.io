---
// Cloudflare Web Analytics, inserted into upstream's Layout <body> from one
// line. See UPSTREAM.md. The beacon loads in production builds when a token is
// provided and the visitor hasn't signaled DNT or GPC. It sits in <body>
// because the script appends to document.body. The script itself lives in
// CloudflareBeaconScript.astro.
import { PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN } from "astro:env/client";
import CloudflareBeaconScript from "./CloudflareBeaconScript.astro";
---

{
  import.meta.env.PROD && PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN && (
    <CloudflareBeaconScript token={PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN} />
  )
}
