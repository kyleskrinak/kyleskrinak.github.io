---
import { WEBRING } from "@/config/constants";
import LinkButton from "./LinkButton.astro";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{
  WEBRING && (
    <div class="border-t border-border py-3">
      <nav
        class:list={[
          "flex items-center justify-center gap-2 text-sm",
          className,
        ]}
        aria-label="IndieWeb webring"
      >
        <LinkButton
          href={WEBRING.prevHref}
          class="p-1"
          aria-label="Previous site in webring"
        >
          <IconChevronLeft class="inline-block size-4 stroke-current stroke-2" />
        </LinkButton>
        <LinkButton href={WEBRING.ringHref}>{WEBRING.ringLabel}</LinkButton>
        <LinkButton
          href={WEBRING.nextHref}
          class="p-1"
          aria-label="Next site in webring"
        >
          <IconChevronRight class="inline-block size-4 stroke-current stroke-2" />
        </LinkButton>
      </nav>
    </div>
  )
}
