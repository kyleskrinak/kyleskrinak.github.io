---
import { SOCIALS } from "@/config/constants";
import LinkButton from "./LinkButton.astro";

interface Props {
  label?: string;
  ariaLabel?: string;
  class?: string;
}

const { label, ariaLabel, class: className } = Astro.props;
const hasLabel = Boolean(label?.trim());
const navLabel =
  (ariaLabel ?? label ?? "").replace(/:\s*$/, "").trim() || "Social links";
---

{
  SOCIALS.length > 0 && (
    <div
      class:list={[
        className,
        hasLabel && "flex max-sm:flex-col sm:items-center",
      ]}
    >
      {hasLabel && (
        <div aria-hidden="true" class="me-2 mb-1 whitespace-nowrap sm:mb-0">
          {label}
        </div>
      )}
      <nav
        class="flex flex-wrap items-center gap-1"
        aria-label={navLabel}
      >
        {
          SOCIALS.map(social => (
            <LinkButton
              href={social.href}
              rel={social.rel}
              class="p-2 hover:rotate-6 sm:p-1"
              title={social.linkTitle}
            >
              <social.icon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent sm:scale-110" />
              <span class="sr-only">{social.linkTitle}</span>
            </LinkButton>
          ))
        }
      </nav>
    </div>
  )
}
