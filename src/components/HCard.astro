---
/**
 * Site-only h-card, inserted by Footer.astro. See UPSTREAM.md.
 *
 * The h-card is only *representative* on the page whose URL its u-url matches,
 * so it renders on the homepage alone. Trailing slashes are normalized because
 * astro.config.ts sets trailingSlash: "always" while BASE_URL may lack one.
 */
import config from "@/config";
import { getAssetPath } from "@/utils/withBase";

const withSlash = (path: string) => (path.endsWith("/") ? path : `${path}/`);
const isHome =
  withSlash(Astro.url.pathname) === withSlash(import.meta.env.BASE_URL || "/");
---

{
  isHome && (
    <div class="pb-6 text-center">
      <div class="inline-block rounded-lg border border-border px-4 py-3">
        <div class="h-card">
          <div class="inline-flex items-center gap-2">
            <img
              src={getAssetPath("favicon-96x96.png")}
              alt=""
              width="32"
              height="32"
              decoding="async"
              class="u-photo size-8 rounded-full"
            />
            <a
              href={config.site.url}
              class="p-name u-url font-semibold underline decoration-dashed underline-offset-4 hover:text-accent"
            >
              {config.site.author}
            </a>
          </div>
          <p class="p-note mx-auto mt-2 max-w-prose text-sm opacity-80">
            Senior manager of web platform operations, writing on web
            technology, AI, low-carb living, and the arts and faith if
            I&rsquo;m so inclined.
          </p>
        </div>
      </div>
    </div>
  )
}
