---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import config from "@/config";
import { useTranslations } from "@/i18n";
import { resolveTimezone } from "@/utils/resolveTimezone";
// SITE-OVERRIDE: a revised post shows its publish date first.
import PublishedDate from "./PublishedDate.astro";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
} = Astro.props;

const t = useTranslations(Astro.currentLocale);

const isModified = modDatetime && modDatetime > pubDatetime;

const datetime = dayjs(isModified ? modDatetime : pubDatetime).tz(
  resolveTimezone(postTimezone ?? config.site.timezone)
);

const date = datetime.format("D MMM, YYYY");

// SITE-OVERRIDE: microformats. The shown date is dt-published, or dt-updated on a
// revised post, where PublishedDate carries dt-published.
const mfClass = isModified ? "dt-updated" : "dt-published";
---

{/* SITE-OVERRIDE: flex-wrap, so a revised post's two dates wrap on phones. */}
<div
  class:list={[
    "text-muted-foreground flex flex-wrap items-center gap-x-2",
    className,
  ]}
>
  <IconCalendar
    class:list={[
      "inline-block size-6 min-w-5.5",
      { "scale-90": size === "sm" },
    ]}
  />
  {/* SITE-OVERRIDE: publish date first on a revised post. */}
  <PublishedDate {pubDatetime} {modDatetime} {size} timezone={postTimezone} />
  {
    isModified && (
      <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>
        {t.post.updatedAt}:
      </span>
    )
  }
  <time
    class:list={[mfClass, "text-sm", { "sm:text-base": size === "lg" }]}
    datetime={datetime.toISOString()}
  >
    {date}
  </time>
</div>
