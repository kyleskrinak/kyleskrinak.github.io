---
import { BLOG_CONTACT_EMAIL } from "@/site-config";

type Props = { title: string };

const { title } = Astro.props;

const mailtoHref = `mailto:${BLOG_CONTACT_EMAIL}?subject=${encodeURIComponent(`Re: ${title}`)}`;
---

<p class="text-sm opacity-80">
  Have a thought? <a
    href={mailtoHref}
    class="hover:text-accent underline decoration-dashed underline-offset-4"
    >Reply by email</a
  >. I read everything that isn't spam.
</p>
