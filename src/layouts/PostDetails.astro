---
import { render, type CollectionEntry } from "astro:content";
import { Image, getImage } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import ReplyViaEmail from "@/components/ReplyViaEmail.astro";
import Webmentions from "@/components/Webmentions.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import { getPath } from "@/utils/getPath";
import { linkWithBase } from "@/utils/linkWithBase";
import { slugifyStr } from "@/utils/slugify";
import { getReadingTime } from "@/utils/readingTime";
import { canonicalizePathname } from "@/utils/canonicalizePathname";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE, HERO_IMAGE } from "@/config";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDate,
  updatedDate,
  tags = [],
  hideEditPost,
  image,
  alt,
  caption,
  imagePosition,
} = post.data;

const { Content } = await render(post);

/* ========== Microformats2 ==========
   The h-entry's u-url is this page, not `canonicalURL` from frontmatter: a
   post may declare an external canonical for SEO, but a webmention receiver
   fetches the URL we sent as the source and needs the entry to identify that
   page. Derived the same way Layout derives its canonical so the two agree
   whenever frontmatter does not override it. */
const postUrl = new URL(
  canonicalizePathname(Astro.url.pathname, import.meta.env.BASE_URL),
  Astro.site
).href;
// The same identity the homepage footer h-card carries: name and URL both read
// SITE, so those cannot drift. The photo is not shared state — this filename is
// a literal here and in Footer.astro, and nothing enforces that the two h-cards
// name the same file. (Layout.astro and site.webmanifest.ts use it too, but as
// the favicon and PWA icon; changing the avatar need not touch those.)
const authorPhoto = new URL(linkWithBase("favicon-96x96.png"), Astro.site).href;

const readingTime = getReadingTime(post.body ?? "");

let ogImageUrl: string | undefined;

// Explicit ogImage from frontmatter (ImageMetadata via image() schema helper)
if (initOgImage && typeof initOgImage === 'object' && 'src' in initOgImage) {
  ogImageUrl = initOgImage.src;
}

// Fall back to hero image. Use the same derivative the hero <Image> renders,
// not the raw source: the source is whatever the author supplied (some are
// portrait, and several exceed 900KB), so scrapers center-crop it and ignore
// `imagePosition`. Sharing HERO_IMAGE with the <Image> below means identical
// transform params, so this resolves to that same generated file and emits no
// extra asset. No format check is needed — content.config.ts rejects SVG heroes
// at build time, so `image` is always a raster Sharp can crop.
if (!ogImageUrl && image) {
  const ogHero = await getImage({
    src: image,
    ...HERO_IMAGE,
    position: imagePosition || "center",
  });
  ogImageUrl = ogHero.src;
}

// Use dynamic OG image if enabled and no remote|local ogImage or hero image
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath, true, false)}/index.png`;
}

// Resolve OG image URL (or fall through to Layout's default)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDate,
  updatedDate,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
};

/* ========== Prev/Next Posts ========== */

const allPosts = posts.map(({ data: { title }, id, filePath }) => ({
  id,
  title,
  filePath,
}));

const currentPostIndex = allPosts.findIndex(a => a.id === post.id);

const prevPost = currentPostIndex !== 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex !== allPosts.length ? allPosts[currentPostIndex + 1] : null;
---

<Layout {...layoutProps}>
  <Header />
  <BackButton />
  <main
    id="main-content"
    class:list={["h-entry", "app-layout pb-12", { "mt-8": !SITE.showBackButton }]}
    data-pagefind-body
  >
    <h1
      transition:name={slugifyStr(title.replaceAll(".", "-"))}
      class="p-name inline-block text-2xl font-bold text-accent sm:text-3xl"
    >
      {title}
    </h1>
    <div class="my-2 flex items-center gap-2">
      <Datetime {pubDate} {updatedDate} size="lg" />
      <span aria-hidden="true" class="text-skin-base opacity-50">·</span>
      <span class="text-sm text-skin-base opacity-80">{readingTime} min read</span>
      <span
        aria-hidden="true"
        class:list={[
          "max-sm:hidden",
          { hidden: !SITE.editPost.enabled || hideEditPost },
        ]}>|</span
      >
      <EditPost {hideEditPost} {post} class="max-sm:hidden" />
    </div>
    {/* Microformats2 identity for this entry. No visible author chrome exists
        on a post page to carry these, and adding one would change the layout,
        so they ride on a hidden block: parsers read the DOM and ignore
        `hidden`, which is what a webmention receiver does with this page.
        u-photo is an <img> and u-url an <a> because those are the primary
        element rules for u-* — a parser reaches them before any fallback. */}
    <div class="post-identity" hidden>
      <a class="u-url" href={postUrl}>{title}</a>
      <div class="p-author h-card">
        <img
          class="u-photo"
          src={authorPhoto}
          alt=""
          width="32"
          height="32"
        />
        <a class="p-name u-url" href={SITE.website}>{SITE.author}</a>
      </div>
    </div>
    {image && (
      <figure class="hero-image mt-8 mb-8 w-full">
        {/* u-featured below is the entry's representative image for link
            previews. It sits inside the h-entry but outside e-content, which is
            the shape the h-entry spec documents — the image is declared once
            here rather than duplicated into the body. (The class cannot be
            annotated inline: Astro rejects a comment in attribute position.)

            HERO_IMAGE's fit + position route to Sharp's resize at build time
            so the generated hero is cropped from the part of the source image
            specified by frontmatter `imagePosition` (default: center).
            densities={[1, 2]} emits a 1x/2x srcset; sources <2400px wide get
            only the 1x candidate (Sharp skips upscaling). */}
        <Image
          src={image}
          alt={alt || "Post hero image"}
          {...HERO_IMAGE}
          position={imagePosition || "center"}
          densities={[1, 2]}
          sizes={`(max-width: 640px) 100vw, (max-width: 1024px) 90vw, ${HERO_IMAGE.width}px`}
          loading="eager"
          decoding="sync"
          class="u-featured rounded-lg shadow-md"
        />
        {caption && (
          <figcaption class="mt-2 text-center text-sm italic text-gray-600 dark:text-gray-400">
            {/* caption is author-controlled frontmatter, not user input — set:html is safe here */}
            <span set:html={caption} />
          </figcaption>
        )}
      </figure>
    )}
    <article
      id="article"
      class="e-content app-prose mt-8 w-full max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
    >
      <Content />
    </article>

    <hr class="my-8 border-dashed" />

    <EditPost class="sm:hidden" {hideEditPost} {post} />

    <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
    </ul>

    <BackToTopButton />

    <ShareLinks />

    <ReplyViaEmail {title} />

    <Webmentions />

    <hr class="my-6 border-dashed" />

    <!-- Previous/Next Post Buttons -->
    <div data-pagefind-ignore class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        prevPost && (
          <a
            href={linkWithBase(getPath(prevPost.id, prevPost.filePath))}
            class="flex w-full gap-1 hover:opacity-75"
          >
            <IconChevronLeft class="inline-block flex-none rtl:rotate-180" />
            <div>
              <span>Previous Post</span>
              <div class="text-sm text-accent/85">{prevPost.title}</div>
            </div>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={linkWithBase(getPath(nextPost.id, nextPost.filePath))}
            class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
          >
            <div>
              <span>Next Post</span>
              <div class="text-sm text-accent/85">{nextPost.title}</div>
            </div>
            <IconChevronRight class="inline-block flex-none rtl:rotate-180" />
          </a>
        )
      }
    </div>
  </main>
  <dialog id="card-lightbox" aria-label="Image lightbox">
    <form method="dialog">
      <button type="submit" aria-label="Close lightbox">✕</button>
    </form>
    <img alt="" />
  </dialog>
  <Footer />
</Layout>

<script is:inline data-astro-rerun>
  /** Create a progress indicator
   *  at the top */
  function createProgressBar() {
    // Create the main container div
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-10 h-1 w-full bg-background";

    // Create the progress bar div
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";

    // Append the progress bar to the progress container
    progressContainer.appendChild(progressBar);

    // Append the progress container to the document body or any other desired parent element
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  /** Update the progress bar
   *  when user scrolls */
  function updateScrollProgress() {
    document.addEventListener("scroll", () => {
      const winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      if (document) {
        const myBar = document.getElementById("myBar");
        if (myBar) {
          myBar.style.width = scrolled + "%";
        }
      }
    });
  }
  updateScrollProgress();

  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("h2, h3, h4, h5, h6")
    );
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ms-2 no-underline opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto focus:opacity-100 focus:pointer-events-auto";
      link.setAttribute("aria-label", "Permalink");
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. */
  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      // Check if --file-name-offset custom property exists
      const computedStyle = getComputedStyle(codeBlock);
      const hasFileNameOffset =
        computedStyle.getPropertyValue("--file-name-offset").trim() !== "";

      // Determine the top positioning class
      const topClass = hasFileNameOffset
        ? "top-(--file-name-offset)"
        : "-top-3";

      const copyButton = document.createElement("button");
      copyButton.className = `copy-code absolute end-3 ${topClass} rounded bg-muted border border-muted px-2 py-1 text-xs leading-4 text-foreground font-medium`;
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      // wrap codebock with relative parent element
      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      // visual feedback that task is completed
      button.innerText = "Copied";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  function initCardLightbox() {
    const dialog = document.getElementById("card-lightbox");
    if (!dialog) return;
    const lightboxImg = dialog.querySelector("img");
    if (!lightboxImg) return;

    function openLightbox(cardImg) {
      if (dialog.open) return;
      dialog._openerEl = cardImg;
      lightboxImg.src = cardImg.currentSrc || cardImg.src;
      lightboxImg.alt = cardImg.alt;
      dialog.showModal();
    }

    document.querySelectorAll(".card-media:not([data-lightbox-bound])").forEach(cardImg => {
      cardImg.dataset.lightboxBound = "1";
      cardImg.setAttribute("tabindex", "0");
      cardImg.setAttribute("role", "button");
      cardImg.setAttribute(
        "aria-label",
        cardImg.alt ? `Enlarge image: ${cardImg.alt}` : "Enlarge image"
      );
      cardImg.addEventListener("click", () => openLightbox(cardImg));
      cardImg.addEventListener("keydown", e => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          openLightbox(cardImg);
        }
      });
    });

    if (!dialog.dataset.listenersBound) {
      dialog.dataset.listenersBound = "1";
      dialog.addEventListener("click", e => {
        if (e.target === dialog) dialog.close();
      });

      dialog.addEventListener("close", () => {
        lightboxImg.removeAttribute("src");
        lightboxImg.alt = "";
        dialog._openerEl?.focus();
        dialog._openerEl = null;
      });
    }
  }
  initCardLightbox();

  /* Go to page start after page swap */
  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );
</script>
