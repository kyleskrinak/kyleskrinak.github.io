---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import ResumeHeader from "@/components/ResumeHeader.astro";
import { resumeMetaDescription } from "@/lib/resume-sections.mjs";
import "@/styles/resume.css";

const page = await getEntry("pages", "resume");
if (!page) throw new Error("Resume page not found");

const { Content } = await render(page);
const { name, contactEmail, contactWebsite, contactLinkedin, contactAddress } = page.data;
if (!name) throw new Error("Resume frontmatter has no name");
// Same composed description as the public route — see src/pages/resume.astro.
const description = resumeMetaDescription(page.data);
---

{/* Canonical points at the public /resume/ page: this route is a noindex
    PDF-rendering source and must not declare itself canonical. The title is
    the name alone: Chromium copies it into the PDF's Title field, and the
    .docx takes the same title from the h1. */}
<Layout
  title={name}
  description={description}
  noindex={true}
  canonicalURL={new URL("/resume/", Astro.site).href}
>
  <main id="main-content" class="app-layout pb-12">
    <ResumeHeader
      name={name}
      contactEmail={contactEmail}
      contactWebsite={contactWebsite}
      contactLinkedin={contactLinkedin}
      contactAddress={contactAddress}
      linkedinAsUrl={true}
    />
    <article class="resume-content mt-8">
      <Content />
    </article>
  </main>
</Layout>
