---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ResumeHeader from "@/components/ResumeHeader.astro";
import { RESUME_DOCX_PATH, RESUME_PDF_PATH, RESUME_TXT_PATH } from "@/config";
import { linkWithBase } from "@/utils/linkWithBase";
import { resumeMetaDescription } from "@/lib/resume-sections.mjs";
import "@/styles/resume.css";

const page = await getEntry("pages", "resume");
if (!page) throw new Error("Resume page not found");

const { Content } = await render(page);
const { title, name, contactEmail, contactWebsite, contactLinkedin } = page.data;
if (!name) throw new Error("Resume frontmatter has no name");
// Composed, not hand-typed: the role sentence comes from current_role, which
// is also what the body's lead heading renders from.
const description = resumeMetaDescription(page.data);
---

{/* Content title already carries the site owner's name — no SITE.title
    suffix, which would render "Kyle Skrinak — Resume | Kyle Skrinak" */}
<Layout
  title={title}
  description={description}
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-12">
    {/* No contactAddress here: the address is print-only and must never
        ship in the public page's markup */}
    <ResumeHeader
      name={name}
      contactEmail={contactEmail}
      contactWebsite={contactWebsite}
      contactLinkedin={contactLinkedin}
    >
      <p class="resume-download mt-4">
        {/* compressHTML drops whitespace that spans a line break next to a tag, so each space is explicit. */}
        You can download my resume as a{" "}
        <a href={linkWithBase(RESUME_PDF_PATH)} target="_blank" rel="noopener noreferrer">PDF</a>,{" "}
        <a href={linkWithBase(RESUME_DOCX_PATH)} target="_blank" rel="noopener noreferrer">DOCX</a>, or{" "}
        <a href={linkWithBase(RESUME_TXT_PATH)} target="_blank" rel="noopener noreferrer">TEXT</a> file.
      </p>
    </ResumeHeader>
    <article class="resume-content mt-8">
      <Content />
    </article>
  </main>
  <Footer />
</Layout>
