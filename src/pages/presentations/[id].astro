---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
import presentations from "@/data/presentations.json";

interface Props {
  id: string;
}

export function getStaticPaths() {
  return presentations.map(pres => ({
    params: { id: pres.id },
    props: { id: pres.id },
  }));
}

const { id } = Astro.props;
const presentation = presentations.find(p => p.id === id);

if (!presentation) {
  return Astro.redirect("/404");
}

const htmlFile = getAssetPath(`/presentations/${id}.html`);
---

<Layout
  title={`${presentation.title} | ${config.site.title}`}
  description={presentation.description}
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-12">
    <div class="mb-8">
      <a
        href={getAssetPath("/presentations/")}
        class="text-accent hover:underline"
      >
        ← Back to Presentations
      </a>
    </div>

    <h1 class="mb-2 text-2xl font-semibold sm:text-3xl">
      {presentation.title}
    </h1>
    <p class="text-foreground/70 mb-6 text-sm">
      {
        new Date(presentation.date).toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })
      }
    </p>

    <div class="mb-8 flex flex-wrap gap-2">
      {
        presentation.tags.map(tag => (
          <span class="bg-foreground/10 text-foreground/70 inline-block rounded px-3 py-1 text-xs">
            {tag}
          </span>
        ))
      }
    </div>

    <p class="text-foreground/80 mb-8">{presentation.description}</p>

    <div class="bg-background border-border mb-8 rounded-lg border p-6">
      <p class="text-foreground/80 mb-4 text-sm">
        Click the button below to open the full presentation in fullscreen mode.
      </p>
      <a
        href={htmlFile}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-accent text-background inline-block rounded px-6 py-3 font-medium transition-opacity hover:opacity-90"
      >
        View Presentation →
      </a>
    </div>

    <div class="prose prose-invert max-w-none">
      <p class="text-foreground/70 text-sm italic">
        This presentation is displayed in a separate window. Use arrow keys or
        click to navigate through the slides.
      </p>
    </div>
  </main>
  <Footer />
</Layout>
